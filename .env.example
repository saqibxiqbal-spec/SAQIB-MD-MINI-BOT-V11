# ================= SAQIB MD Premium WhatsApp Bot =================
# Copy this file to .env and fill in your values.
# NOTE: every auto/anti feature defaults to OFF. Turn them ON live with
# a toggle command (e.g. .antidelete, .autoreact) — the choice is saved.

# ---- Identity ----
BOT_NAME=SAQIB MD
PREFIX=.
OWNER_NAME=I'm Saqib king 👑
# Owner WhatsApp number with country code, digits only (e.g. 923001234567).
# Default owner number for SAQIB MD:
OWNER_NUMBER=923106762478

# ---- Portal security ----
# Secret that protects the owner-only parts of the web portal (the list of
# linked numbers + the remove button). If left blank, a strong random token is
# generated at boot and printed to the console (set it here to keep it stable).
ADMIN_TOKEN=
# Optional lock screen for the WHOLE portal. Any value = locked; "off" = public.
PORTAL_PASSWORD=off

# ---- Social links (shown in .menu, .owner, .channel and .group) ----
# Optional: set these to YOUR OWN WhatsApp channel / group invite link.
CHANNEL_LINK=
GROUP_LINK=

# ---- AI (Google Gemini) ----
# Get a free key: https://aistudio.google.com/app/apikey
# NOTE: gemini-2.x models are blocked for new keys — use gemini-3.5-flash.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Optional: GitHub personal-access token used by the `.gist` command to create
# private gists. Leave blank to disable `.gist` (`.pastebin` needs no token).
GITHUB_TOKEN=

# ---- Behaviour (ALL OFF BY DEFAULT) ----
# public = everyone can use commands | private = only the owner can
MODE=public
AUTO_READ=false
AUTO_TYPING=false
# Boot default for a brand-new bot. Each linked number keeps its OWN choice
# (PER-BOT) — change live with `.autoreact` / `.userreact` (numbered menu).
AUTO_REACT=false
# MIRROR EMOJI (per-bot, default ON): when a user sends an emoji-only message
# the bot reacts to THAT message with the EXACT same emoji. Toggle live with
# `.mirrorreact on|off`. Shown in `.autoreact` / `.premium` status.
MIRROR_EMOJI=true
# ---- Auto-react scope (only meaningful when AUTO_REACT is on) ----
# all   = react to everyone (users + owner)
# user  = react only to normal users (the owner is left out)
# owner = react only to the owner
REACT_SCOPE=all
# ===================== LOCKED OWNER REACTION ==========================
# The owner is ALWAYS reacted to with 🧑‍💻 — in groups AND DMs — by EVERY
# bot, with nothing switched on. These two are HARD-CODED in config.js and are
# NOT changeable by any command (.ownerreact / .reactemoji only show a
# "locked" notice). They are listed here for reference only.
OWNER_REACT_EMOJI=🧑‍💻
OWNER_REACT_ALWAYS=true
# Emoji the bot puts on incoming STATUSES (default 💚). Change live: .statusemoji
STATUS_EMOJI=💚
WELCOME=false
GOODBYE=false
ANTILINK=false
ANTIDELETE=false
# anti-delete also for inbox / DM chats
ANTIDELETE_INBOX=false
ANTISPAM=false
ANTICALL=false
AUTOSTATUS=false
# auto-save a status when someone replies to it (sends it to the owner)
AUTOSAVESTATUS=false
# auto-forward view-once media to the bot's own chat (default ON)
AUTOVIEWONCE=true
AUTOBIO=false
CHATBOT=false
AUTOREAD_STATUS=false
RECORDING=false
STATUSVIEW=false
ADMINISTRATION=false
MENTION_REPLY=false
# show "online" presence (default ON)
ONLINE=true

TIMEZONE=Asia/Karachi
PORT=3000

# ---- Session / multi-session ----
SESSION_DIR=./session
# Optional: base64 encoded session (for restoring a session on redeploy)
SESSION_ID=
# How many WhatsApp numbers can be linked at once (default 500)
MAX_SESSIONS=500

# ---- Extra owners (comma separated numbers) ----
SUDO=

# ---- Downloads ----
# YouTube bot-blocks datacenter IPs with
# "Sign in to confirm you're not a bot". Paste a Netscape cookies.txt export of
# your logged-in youtube.com session here to fix it. Leave blank to let the bot
# fall back to a mirror / SoundCloud automatically.
YT_COOKIES=

# ---- Settings persistence (optional) ----
# On a host with an ephemeral disk the local settings file is wiped on redeploy.
# Set MONGODB_URI to YOUR OWN MongoDB cluster so EVERY runtime setting (toggles,
# per-bot react, prefixes, reacts, bans) is stored there and restored on the next
# boot. Optional MONGODB_DB (default: saqib_md).
#
# MongoDB ALSO persists:
#   - SESSIONS  -> each linked number's auth state is mirrored to the `sessions`
#                  collection and rebuilt on boot, so a container restart
#                  reconnects automatically with NO re-pairing.
#   - API KEYS  -> media-downloader keys/endpoints (collection `api_keys`),
#                  managed live with `.setapikey` / `.apikeys` / `.delapikey`.
MONGODB_URI=
MONGODB_DB=saqib_md
# Optional SECOND endpoint. Tried automatically when MONGODB_URI is unreachable
# (e.g. Atlas IP-whitelist rejects this host). Useful for a local mongod:
#   MONGODB_URI_FALLBACK=mongodb://127.0.0.1:27017
MONGODB_URI_FALLBACK=

# ---- Last-resort persistence: private GitHub state repo ----
# If BOTH MongoDB endpoints above are unreachable (e.g. Atlas rejects the host
# IP with "SSL alert number 80"), the bot stores the exact same settings blobs
# in ONE JSON file inside a PRIVATE GitHub repo. Nothing else in the code
# changes — same getDoc/setDoc API. Writes are debounced (~1 commit / 10s).
# Use a PRIVATE repo: this file can contain API keys and session creds.
#   GITHUB_TOKEN=ghp_xxx
#   GITHUB_STATE_REPO=owner/private-repo
#   GITHUB_STATE_PATH=state.json
#   GITHUB_STATE_BRANCH=main
GITHUB_STATE_REPO=
GITHUB_STATE_PATH=state.json
# Legacy alternative: a plain GET/PUT JSON blob. Run
# `node scripts/make-settings-store.js` (or use the portal button) and paste the
# printed URL here. MONGODB_URI takes priority when both are set.
SETTINGS_URL=

# ─────────────────────────────────────────────────────────────────────────────
# ADDITIONAL OPTIONS (documented for completeness — all optional)
# ─────────────────────────────────────────────────────────────────────────────

# ── Owner / branding ─────────────────────────────────────────────────────────
OWNER_EMAIL=
REPO_LINK=https://github.com/saqibxiqbal-spec/SAQIB-MD-MINI-BOT-V11
DESCRIPTION=SAQIB MD — Premium WhatsApp Bot
STICKER_NAME=SAQIB MD
BOT_PIC=./assets/bot.jpg
DEFAULT_FONT=mono
DEFAULT_COUNTRY_CODE=92

# ── Privacy (default | contacts | contact_blacklist | all | none) ────────────
PRIVACY=default
GROUP_PRIVACY=default

# ── Auto-react scope ─────────────────────────────────────────────────────────
AUTO_REACT_GROUP=true
AUTO_REACT_CHAT=true

# ── Status / greeting ────────────────────────────────────────────────────────
STATUSLIKE=false
AUTOGREET=false
WELCOME_MSG=👋 Welcome @user to @group!
GOODBYE_MSG=🕊️ @user left @group. Allah Hafiz!

# ── Anti-abuse extras ────────────────────────────────────────────────────────
ANTIDELETE_TO_CHAT=false
ANTIEDIT=false
ANTICALL_MSG=

# ── Image generation ─────────────────────────────────────────────────────────
GEMINI_IMAGE_ENABLED=false
GEMINI_IMAGE_MODEL=imagen-4.0-generate-001
POLLINATIONS_API_KEY=
POLLINATIONS_IMAGE_MODEL=community/scriptsnsenses-sys/flux-2-dev-free
POLLINATIONS_IMAGE_FALLBACK=community/scriptsnsenses-sys/sdxl-lightning-free
